pragma solidity 0.8.26;

import "lib/forge-std/src/Test.sol";
import "../src/NexusSettler.sol";

contract NexusSettlerTest is Test {
    NexusSettler public nexusSettler;
    address public escrow;

    function setUp() public {
        escrow = makeAddr("escrow");
        nexusSettler = new NexusSettler(escrow);
    }

    function testFillRevertsWithInvalidOrderId() public {
        // Arrange
        bytes32 orderId = keccak256("invalid_order_id");
        bytes memory originData = abi.encode("some_origin_data");
        bytes memory fillerData = abi.encode("some_filler_data");

        // The orderId should be keccak256(abi.encodePacked(originData)) to be valid
        // Since we're using a different orderId, it should revert with InvalidOrderId

        // Act & Assert
        vm.expectRevert(
            abi.encodeWithSelector(INexusSettler.InvalidOrderId.selector)
        );
        nexusSettler.fill(orderId, originData, fillerData);
    }

    function testFillWithValidOrderIdDoesNotRevertWithInvalidOrderId() public {
        // Arrange
        bytes
            memory originData = "";
        bytes32 validOrderId = 0x8e504b518f63294eb400c9f1146677dca6927b8350101a8e0788bbfeee2dd00b;
        bytes memory fillerData = abi.encode("some_filler_data");

        // Act & Assert - This should not revert with InvalidOrderId
        // (it might revert with other errors due to incomplete implementation, but not InvalidOrderId)
        // Expect some revert, but not InvalidOrderId
        nexusSettler.fill(validOrderId, originData, fillerData);

        // If we want to be more specific, we can check it doesn't revert with InvalidOrderId
        // by catching the revert and ensuring it's not InvalidOrderId
    }
}
